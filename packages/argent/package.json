{
  "name": "@e2e-dev/argent",
  "version": "0.1.0",
  "description": "Argent Cloud hosted iOS simulators for e2e mobile tests",
  "keywords": [
    "e2e",
    "testing",
    "argent",
    "argent-cloud",
    "ios-simulator",
    "ci"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e2e-inc/e2e.git",
    "directory": "packages/argent"
  },
  "bugs": {
    "url": "https://github.com/e2e-inc/e2e/issues"
  },
  "homepage": "https://github.com/e2e-inc/e2e/tree/main/packages/argent#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "shims"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "peerDependencies": {
    "@e2e-dev/mobile": ">=0.11.1 <1",
    "e2e": ">=0.15.0 <1"
  },
  "devDependencies": {
    "@e2e-dev/mobile": "workspace:*",
    "@types/node": "26.6.6",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "dependencies": {
    "agent-device": "0.21.42"
  }
}
